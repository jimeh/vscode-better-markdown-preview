// Place shared project settings here so Glaze can own settings.json separately.
{
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "explicit"
	},
	"oxc.typeAware": true,
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[markdown]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[css]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"stylelint.validate": ["css"],
	"files.exclude": {
		"artifacts": false,
		"dist": false,
		"out": false
	},
	"search.exclude": {
		".vscode-test": true,
		"artifacts": true,
		"dist": true,
		"out": true
	},
	// The package scripts already provide the TypeScript watch tasks.
	"typescript.tsc.autoDetect": "off"
}

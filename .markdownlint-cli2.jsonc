{
	"config": {
		"MD012": {
			"maximum": 2,
		},
		"MD013": false,
		"MD024": {
			"siblings_only": true,
		},
	},
	"globs": ["**/*.md"],
	"overrides": [
		{
			"filter": ["README.md"],
			"config": {
				"MD033": false,
				"MD041": false,
			},
			"combine": "merge",
		},
	],
	"ignores": [
		".vscode-test/**",
		"CLAUDE.md",
		"artifacts/**",
		"dist/**",
		"node_modules/**",
		"out/**",
		"test/fixtures/**",
	],
}
